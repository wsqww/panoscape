# 复制本文件为 .env.local 并填入真实值（.env.local 已被 .gitignore 忽略，不会进入仓库）。
# 线上构建：在仓库 Settings → Secrets and variables → Actions 配置同名 Secret，
# 构建时由 .github/workflows/deploy-pages.yml 自动注入。

# 天地图浏览器端密钥（卫星图层备选源；留空使用 Esri World Imagery）
VITE_TIANDITU_KEY=

# 百度地图浏览器端 AK（景点级 360° 全景；留空启用景区级 720 云备选入口）
VITE_BAIDU_MAP_AK=
